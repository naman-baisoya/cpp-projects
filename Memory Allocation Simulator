#include <iostream>
#include <vector>
#include <limits>

using namespace std;

// First Fit Algorithm
void firstFit(const vector<int>& blocks, const vector<int>& processes)
{
    vector<bool> allocated(blocks.size(), false);

    cout << "\nFIRST FIT \n";

    for (size_t i = 0; i < processes.size(); i++)
    {
        bool found = false;

        for (size_t j = 0; j < blocks.size(); j++)
        {
            if (!allocated[j] && blocks[j] >= processes[i])
            {
                cout << "Process " << i + 1
                     << " (" << processes[i] << " KB)"
                     << " -> Block " << j + 1 << endl;

                allocated[j] = true;
                found = true;
                break;
            }
        }

        if (!found)
        {
            cout << "Process " << i + 1
                 << " (" << processes[i] << " KB)"
                 << " -> Not Allocated\n";
        }
    }
}

// Best Fit Algorithm
void bestFit(const vector<int>& blocks, const vector<int>& processes)
{
    vector<bool> allocated(blocks.size(), false);

    cout << "\nBEST FIT\n";

    for (size_t i = 0; i < processes.size(); i++)
    {
        int bestBlock = -1;

        for (size_t j = 0; j < blocks.size(); j++)
        {
            if (!allocated[j] && blocks[j] >= processes[i])
            {
                if (bestBlock == -1 || blocks[j] < blocks[bestBlock])
                {
                    bestBlock = j;
                }
            }
        }

        if (bestBlock != -1)
        {
            cout << "Process " << i + 1
                 << " (" << processes[i] << " KB)"
                 << " -> Block " << bestBlock + 1 << endl;

            allocated[bestBlock] = true;
        }
        else
        {
            cout << "Process " << i + 1
                 << " (" << processes[i] << " KB)"
                 << " -> Not Allocated\n";
        }
    }
}

// Worst Fit Algorithm
void worstFit(const vector<int>& blocks, const vector<int>& processes)
{
    vector<bool> allocated(blocks.size(), false);

    cout << "\nWORST FIT \n";

    for (size_t i = 0; i < processes.size(); i++)
    {
        int worstBlock = -1;

        for (size_t j = 0; j < blocks.size(); j++)
        {
            if (!allocated[j] && blocks[j] >= processes[i])
            {
                if (worstBlock == -1 || blocks[j] > blocks[worstBlock])
                {
                    worstBlock = j;
                }
            }
        }

        if (worstBlock != -1)
        {
            cout << "Process " << i + 1
                 << " (" << processes[i] << " KB)"
                 << " -> Block " << worstBlock + 1 << endl;

            allocated[worstBlock] = true;
        }
        else
        {
            cout << "Process " << i + 1
                 << " (" << processes[i] << " KB)"
                 << " -> Not Allocated\n";
        }
    }
}

int main()
{
    int numberOfBlocks;
    int numberOfProcesses;
    int choice;

    cout << "::MEMORY ALLOCATION SIMULATOR::\n";

    // Enter memory blocks with validation
    while (true)
    {
        cout << "Enter number of memory blocks: ";
        if (cin >> numberOfBlocks && numberOfBlocks > 0) break;
        cout << "Invalid input.\n";
        cin.clear();
        cin.ignore(10000, '\n');
    }

    vector<int> blocks(numberOfBlocks);
    cout << "Enter memory block sizes (KB):\n";
    for (int i = 0; i < numberOfBlocks; i++)
    {
        while (true)
        {
            cout << "Block " << i + 1 << ": ";
            if (cin >> blocks[i] && blocks[i] > 0) break;
            cout << "Invalid size. Must be greater than 0.\n";
            cin.clear();
            cin.ignore(10000, '\n');
        }
    }

    // Enter processes with validation
    while (true)
    {
        cout << "\nEnter number of processes: ";
        if (cin >> numberOfProcesses && numberOfProcesses > 0) break;
        cout << "Invalid input. Please enter a positive integer.\n";
        cin.clear();
        cin.ignore(10000, '\n');
    }

    vector<int> processes(numberOfProcesses);
    cout << "Enter process sizes (KB):\n";
    for (int i = 0; i < numberOfProcesses; i++)
    {
        while (true)
        {
            cout << "Process " << i + 1 << ": ";
            if (cin >> processes[i] && processes[i] > 0) break;
            cout << "Invalid size. Must be greater than 0.\n";
            cin.clear();
            cin.ignore(10000, '\n');
        }
    }

    // Menu loop with validation
    do
    {
        cout << "\n";
        cout << "1. First Fit\n";
        cout << "2. Best Fit\n";
        cout << "3. Worst Fit\n";
        cout << "4. Exit\n";
        cout << "Choose an option: ";

        if (!(cin >> choice))
        {
            cout << "\nInvalid input! Please enter a number.\n";
            cin.clear();
            cin.ignore(10000, '\n');
            continue;
        }

        if (choice == 1)
        {
            firstFit(blocks, processes);
        }
        else if (choice == 2)
        {
            bestFit(blocks, processes);
        }
        else if (choice == 3)
        {
            worstFit(blocks, processes);
        }
        else if (choice == 4)
        {
            cout << "\nProgram ended.\n";
        }
        else
        {
            cout << "\nInvalid choice. Please choose between 1 and 4.\n";
        }

    } while (choice != 4);

    return 0;
}
