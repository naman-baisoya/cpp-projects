#include <iostream>
using namespace std;

// Calculate voltage
double voltage(double current, double resistance) {
    return current * resistance;
}

// Calculate current
double current(double voltage, double resistance) {
    return voltage / resistance;
}

// Calculate resistance
double resistance(double voltage, double current) {
    return voltage / current;
}

// Series resistance
double seriesResistance(double r[], int n) {
    double total = 0;

    for (int i = 0; i < n; i++) {
        total = total + r[i];
    }

    return total;
}

// Parallel resistance
double parallelResistance(double r[], int n) {
    double total = 0;

    for (int i = 0; i < n; i++) {
        total = total + (1.0 / r[i]);
    }

    return 1.0 / total;
}

int main() {

    int choice;

    do {
        cout << "\n===== OHM'S LAW CALCULATOR =====\n";
        cout << "1. Calculate Voltage\n";
        cout << "2. Calculate Current\n";
        cout << "3. Calculate Resistance\n";
        cout << "4. Series Resistors\n";
        cout << "5. Parallel Resistors\n";
        cout << "6. Exit\n";

        cout << "Choose: ";
        cin >> choice;

        if (choice == 1) {

            double I, R;

            cout << "Enter current (A): ";
            cin >> I;

            cout << "Enter resistance (Ohms): ";
            cin >> R;

            cout << "Voltage = " << voltage(I, R) << " V\n";
        }

        else if (choice == 2) {

            double V, R;

            cout << "Enter voltage (V): ";
            cin >> V;

            cout << "Enter resistance (Ohms): ";
            cin >> R;

            if (R == 0)
                cout << "Resistance cannot be zero.\n";
            else
                cout << "Current = " << current(V, R) << " A\n";
        }

        else if (choice == 3) {

            double V, I;

            cout << "Enter voltage (V): ";
            cin >> V;

            cout << "Enter current (A): ";
            cin >> I;

            if (I == 0)
                cout << "Current cannot be zero.\n";
            else
                cout << "Resistance = " << resistance(V, I)
                     << " Ohms\n";
        }

        else if (choice == 4) {

            int n;
            double r[100];

            cout << "How many resistors? ";
            cin >> n;

            for (int i = 0; i < n; i++) {
                cout << "Enter R" << i + 1 << ": ";
                cin >> r[i];
            }

            cout << "Series Resistance = "
                 << seriesResistance(r, n)
                 << " Ohms\n";
        }

        else if (choice == 5) {

            int n;
            double r[100];

            cout << "How many resistors? ";
            cin >> n;

            for (int i = 0; i < n; i++) {
                cout << "Enter R" << i + 1 << ": ";
                cin >> r[i];
            }

            cout << "Parallel Resistance = "
                 << parallelResistance(r, n)
                 << " Ohms\n";
        }

        else if (choice == 6) {
            cout << "Goodbye!\n";
        }

        else {
            cout << "Invalid choice.\n";
        }

    } while (choice != 6);

    return 0;
}
